# ---------------------------------------------------------------------
# Pearl Framework — Production Environment Configuration
# Copy this file to .env on your production server.
# Set strong, unique credentials and never commit this file.
# ---------------------------------------------------------------------

# --- Application ---
APP_NAME="Pearl"
APP_ENV=production
APP_TIMEZONE=UTC
APP_URL=https://your-production-domain.com

# --- Auth ---
# Always keep dual auth isolated in production
AUTH_MODE=dual

# --- Database ---
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pearl_production
DB_USERNAME=pearl_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD

# --- Session ---
# Use database or redis in production (recommended for multi-server or restarts)
SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- Cache ---
# Use database or redis in production for persistent, clustered caching
CACHE_DRIVER=database

# --- Queue ---
# Use database or redis in production for reliable background task processing
QUEUE_DRIVER=database

# --- Mail ---
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=noreply@your-production-domain.com
MAIL_FROM_NAME="Pearl Production"
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=YOUR_SMTP_API_KEY
SMTP_ENCRYPTION=tls

# --- Redis (If using SESSION_DRIVER=redis, CACHE_DRIVER=redis, or QUEUE_DRIVER=redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DATABASE=0

# --- Security ---
# Strict CSP header automatically enforced in production
CSP_ENABLED=true
# Set true only if sitting behind a trusted reverse proxy (e.g. Nginx, Cloudflare, AWS ALB)
TRUST_PROXY=true
