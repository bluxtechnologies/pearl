# Pearl Framework — .gitattributes

# Force LF line endings for consistency across platforms
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Export ignore rules for Composer package distribution
.gitattributes export-ignore
.gitignore export-ignore
.env.example export-ignore
.env.production.example export-ignore
DEPLOYMENT.md export-ignore
deploy/ export-ignore
scratch/ export-ignore
dist/ export-ignore
tests/ export-ignore
package.json export-ignore
package-lock.json export-ignore
vite.config.js export-ignore
node_modules/ export-ignore
storage/logs/* export-ignore
storage/sessions/* export-ignore
storage/cache/* export-ignore
storage/queue/* export-ignore
storage/rate_limits/* export-ignore
