# ---------------------------------------------------------------------
# Pearl Framework — Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------

# --- Application ---
APP_NAME="Pearl"
APP_ENV=local
# Options: local | development | staging | production
APP_TIMEZONE=UTC
APP_URL=http://localhost:7200

# --- Auth ---
# Options: dual (default, recommended) | single
AUTH_MODE=dual

# --- Database ---
# Options: mysql | pgsql | sqlite
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pearl
DB_USERNAME=root
DB_PASSWORD=

# --- Session ---
# Options: file | database | redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Cache ---
# Options: file | database | redis
CACHE_DRIVER=file

# --- Queue ---
# Options: file | sync | database | redis
QUEUE_DRIVER=file

# --- Mail ---
# Options: log | smtp
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Pearl Framework"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# --- Redis (Optional: required only if using redis drivers) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- Vite / Frontend Dev Server ---
VITE_HOST=localhost
VITE_PORT=5173

# --- Security ---
CSP_ENABLED=false
TRUST_PROXY=false
